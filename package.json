{
  "name": "prompter-workbuddy",
  "productName": "提词器",
  "version": "1.0.0",
  "description": "Apple 风 Windows 桌面提词器 · Electron + React + Vite",
  "main": "electron/main.js",
  "author": "workbuddy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && node scripts/dev-electron.cjs\"",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5",
    "wait-on": "^9.0.1"
  }
}
